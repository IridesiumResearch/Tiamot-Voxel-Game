+/// Offer only verified, cached bytes, once per connection and off the network task.
+fn offer_ui_image(
+    hash: ContentHash,
+    cache: &ContentCache,
+    events: &mpsc::UnboundedSender<Event>,
+    fetches: &mut crate::ui_images::Fetches,
+) {
+    let Some(bytes) = cache.get(&hash) else {
+        return;
+    };
+    if !fetches.offer(hash) {
+        return;
+    }
+    let events = events.clone();
+    tokio::task::spawn_blocking(move || match crate::texture::decode_png_isolated(&bytes) {
+        Ok(image) => {
+            let _ = events.send(Event::UiImage { hash, image });
+        }
+        Err(err) => {
+            let _ = events.send(Event::Warning(format!(
+                "UI artwork from this server was refused: {err}"
+            )));
+        }
+    });
+}
