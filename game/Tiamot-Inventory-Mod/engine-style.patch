+// SPDX-FileCopyrightText: Iridesium
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Fuzz the UI PNG ingest and nine-slice geometry at narrow and wide sizes.
+#![no_main]
+
+use libfuzzer_sys::fuzz_target;
+
+fuzz_target!(|data: &[u8]| {
+    let Ok(image) = client::texture::decode_png(data) else {
+        return;
+    };
+    assert!(image.rgba.len() as u64 <= client::texture::MAX_DECODED_BYTES);
+    let rect = egui::Rect::from_min_size(
+        egui::Pos2::ZERO,
+        egui::vec2(image.width as f32, image.height as f32),
+    );
+    for (destination, source) in client::ui_images::slices(rect) {
+        assert!(destination.width() >= 0.0 && destination.height() >= 0.0);
+        assert!(rect.contains_rect(destination));
+        assert!(source.min.x >= 0.0 && source.max.x <= 1.0);
+    }
+});
