+/// Resolves a control's fill without discarding a mod's colour or alpha.
+fn control_fill(style: &Style, fallback: u8, hovered: bool) -> egui::Color32 {
+    let mut rgba = style
+        .background
+        .unwrap_or([fallback, fallback, fallback, 255]);
+    if hovered {
+        for channel in &mut rgba[..3] {
+            *channel = channel.saturating_add(26);
+        }
+    }
+    egui::Color32::from_rgba_unmultiplied(rgba[0], rgba[1], rgba[2], rgba[3])
+}
+
+/// Interactive widgets paint their own fill, so their border must come last.
+fn paint_control(
+    ui: &egui::Ui,
+    rect: egui::Rect,
+    style: &Style,
+    fallback: u8,
+    hovered: bool,
+    icons: Icons<'_>,
