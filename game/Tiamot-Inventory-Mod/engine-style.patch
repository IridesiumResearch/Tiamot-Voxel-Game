+// SPDX-FileCopyrightText: Iridesium
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Content-addressed UI textures and nine-slice painting. No theme lives here.
+//! Images use the existing bounded, panic-isolated PNG decoder on workers.
+//! Eight distinct images per connection cap retained decoded data at 64 MiB.
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use tiamot_core::proto::ContentHash;
+
+/// Maximum distinct UI image hashes requested during one connection.
+pub const MAX_IMAGES: usize = 8;
+
+/// GPU handles exposed to the dialog and HUD painters for one frame.
+pub type Textures = BTreeMap<ContentHash, egui::TextureId>;
+
+/// Render-thread texture lifetime, owned by one connected App.
+#[derive(Default)]
+pub struct Images {
+    requested: BTreeSet<ContentHash>,
+    ready: BTreeMap<ContentHash, crate::texture::Image>,
+    textures: BTreeMap<ContentHash, egui::TextureHandle>,
+}
+
+impl Images {
+    /// Accepts a decoded response only for a hash this App requested.
+    pub fn accept(&mut self, hash: ContentHash, image: crate::texture::Image) {
+        if self.requested.contains(&hash) && !self.textures.contains_key(&hash) {
+            self.ready.insert(hash, image);
+        }
+    }
+
+    /// Deduplicates requests across frames and enforces the connection budget.
+    pub fn request(&mut self, hashes: impl IntoIterator<Item = ContentHash>) -> Vec<ContentHash> {
+        let mut missing = Vec::new();
+        for hash in hashes {
+            if self.requested.len() < MAX_IMAGES && self.requested.insert(hash) {
+                missing.push(hash);
+            }
+        }
+        missing
+    }
+
+    /// Uploads finished images; owning handles releases textures on disconnect.
+    pub fn prepare(&mut self, ctx: &egui::Context) -> Textures {
+        for (hash, image) in std::mem::take(&mut self.ready) {
+            let size = [image.width as usize, image.height as usize];
+            let pixels = egui::ColorImage::from_rgba_unmultiplied(size, &image.rgba);
+            let texture = ctx.load_texture("mod-ui-image", pixels, egui::TextureOptions::LINEAR);
+            self.textures.insert(hash, texture);
+        }
+        self.textures
+            .iter()
+            .map(|(hash, texture)| (*hash, texture.id()))
+            .collect()
+    }
+}
+
+/// A requested image may be offered only once, even if slices are repeated.
+#[derive(Default)]
+pub struct Fetches {
+    requested: BTreeSet<ContentHash>,
+    offered: BTreeSet<ContentHash>,
+}
+
+impl Fetches {
+    /// Records a small bounded set and returns newly requested hashes.
+    pub fn request(&mut self, hashes: Vec<ContentHash>) -> Vec<ContentHash> {
+        let mut fresh = Vec::new();
+        for hash in hashes.into_iter().take(MAX_IMAGES) {
+            if self.requested.len() < MAX_IMAGES && self.requested.insert(hash) {
+                fresh.push(hash);
+            }
+        }
+        fresh
+    }
+
+    /// Whether the caller should launch one decode for these verified bytes.
+    pub fn offer(&mut self, hash: ContentHash) -> bool {
+        self.requested.contains(&hash) && self.offered.insert(hash)
+    }
+}
+
+/// Nine destination/source pairs, retaining square corners on narrow controls.
+/// Source corners occupy a quarter of the texture; destination corners are
+/// at most 52 points. The center and rails alone stretch.
+#[must_use]
+pub fn slices(rect: egui::Rect) -> [(egui::Rect, egui::Rect); 9] {
+    let edge = 52.0_f32
+        .min(rect.width().max(0.0) / 4.0)
+        .min(rect.height().max(0.0) / 4.0);
+    let xs = [
+        rect.left(),
+        rect.left() + edge,
+        rect.right() - edge,
+        rect.right(),
+    ];
+    let ys = [
+        rect.top(),
+        rect.top() + edge,
+        rect.bottom() - edge,
+        rect.bottom(),
+    ];
+    let uv = [0.0, 0.25, 0.75, 1.0];
+    std::array::from_fn(|i| {
+        let x = i % 3;
+        let y = i / 3;
+        (
+            egui::Rect::from_min_max(egui::pos2(xs[x], ys[y]), egui::pos2(xs[x + 1], ys[y + 1])),
+            egui::Rect::from_min_max(egui::pos2(uv[x], uv[y]), egui::pos2(uv[x + 1], uv[y + 1])),
+        )
+    })
+}
+
+/// Paints a full image or its nine slices from an already-uploaded texture.
+pub fn paint(painter: &egui::Painter, texture: egui::TextureId, rect: egui::Rect, sliced: bool) {
+    if sliced {
+        for (destination, uv) in slices(rect) {
+            if destination.is_positive() {
+                painter.image(texture, destination, uv, egui::Color32::WHITE);
+            }
+        }
+    } else {
+        painter.image(
+            texture,
+            rect,
+            egui::Rect::from_min_max(egui::Pos2::ZERO, egui::pos2(1.0, 1.0)),
+            egui::Color32::WHITE,
+        );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn bundled_ornate_artwork_decodes_and_uploads() {
+        let ctx = egui::Context::default();
+        let mut images = Images::default();
+        for bytes in [
+            include_bytes!("../../../mods/tiamot_inventory/textures/ornate-panel.png").as_slice(),
+            include_bytes!("../../../mods/tiamot_inventory/textures/iron-slot.png").as_slice(),
+        ] {
+            let hash = tiamot_core::content::hash_bytes(bytes);
+            let image = crate::texture::decode_png_isolated(bytes)
+                .expect("generated PNG must be supported");
+            assert_eq!(image.width, image.height);
+            images.request([hash]);
+            images.accept(hash, image);
+        }
+        let textures = images.prepare(&ctx);
+        assert_eq!(textures.len(), 2);
+        assert!(images.ready.is_empty());
+        assert_eq!(
+            images.prepare(&ctx),
+            textures,
+            "textures must be reused across frames"
+        );
+    }
+
+    #[test]
+    fn repeated_unknown_hashes_cannot_grow_the_image_budget() {
+        let mut images = Images::default();
+        assert_eq!(images.request((0..30).map(|n| [n; 32])).len(), MAX_IMAGES);
+        assert!(images.request([[0; 32], [80; 32]]).is_empty());
+        images.accept([80; 32], crate::texture::Image::solid(1, 1, [0; 4]));
+        assert!(images.ready.is_empty());
+        let mut fetches = Fetches::default();
+        assert_eq!(fetches.request(vec![[1; 32]; 10]), vec![[1; 32]]);
+        assert!(fetches.offer([1; 32]));
+        assert!(!fetches.offer([1; 32]));
+        assert!(!fetches.offer([2; 32]));
+    }
+
+    #[test]
+    fn nine_slices_cover_small_and_wide_rectangles_without_inversion() {
+        for (w, h) in [(8.0, 8.0), (64.0, 64.0), (240.0, 44.0), (900.0, 700.0)] {
+            let rect = egui::Rect::from_min_size(egui::pos2(12.0, 8.0), egui::vec2(w, h));
+            let slices = slices(rect);
+            let area: f32 = slices.iter().map(|(r, _)| r.area()).sum();
+            assert!((area - w * h).abs() < 0.1);
+            for (r, uv) in slices {
+                assert!(r.width() >= 0.0 && r.height() >= 0.0);
+                assert!(rect.contains_rect(r));
+                assert!(uv.min.x >= 0.0 && uv.max.x <= 1.0);
+            }
+        }
+    }
+}
