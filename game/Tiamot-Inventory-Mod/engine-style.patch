+#[test]
+fn ornate_inventory_dialog_fetches_its_real_artwork_over_the_connection() {
+    let server = ServerHandle::start(&Settings {
+        bind_addr: "127.0.0.1:0".parse().expect("loopback"),
+        world_path: scratch("ornate-ui-world"),
+        max_players: 4,
+        allowlist: Allowlist::open(),
+        operators: Vec::new(),
+        view_distance: ViewDistance::MINIMUM,
+        mods_path: Some(PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../mods")),
+        enabled_mods: Some(vec!["tiamot_inventory".to_owned()]),
+        seed: Some(4242),
+        rcon: None,
+        materials: Vec::new(),
+    })
+    .expect("start with the standalone UI mod");
+    let home = Home::new("ornate-ui");
+    let mut connection = home.open(&server);
+    let mut seen = Seen::default();
+    assert!(pump(&mut connection, &mut seen, |s| s.joined.is_some()));
+    connection.send(Command::Action {
+        id: "tiamot_inventory:inventory".to_owned(),
+        pressed: true,
+    });
+    assert!(pump(&mut connection, &mut seen, |s| s
+        .dialogs
+        .contains_key("tiamot_inventory:inventory")));
+    let tree = &seen.dialogs["tiamot_inventory:inventory"];
+    let hashes: std::collections::BTreeSet<_> = tree
+        .nodes
+        .iter()
+        .filter_map(|node| node.style.nine_slice)
+        .collect();
+    assert_eq!(
+        hashes.len(),
+        2,
+        "both frames must be referenced by actual widgets"
+    );
+    for bytes in [
+        include_bytes!("../../../mods/tiamot_inventory/textures/ornate-panel.png").as_slice(),
+        include_bytes!("../../../mods/tiamot_inventory/textures/iron-slot.png").as_slice(),
+    ] {
+        assert!(hashes.contains(&tiamot_core::content::hash_bytes(bytes)));
+    }
+    connection.send(Command::UiImages(hashes.into_iter().collect()));
+    assert!(
+        pump(&mut connection, &mut seen, |s| s.ui_images.len() == 2),
+        "received {} images; warnings: {:?}",
+        seen.ui_images.len(),
+        seen.warnings
+    );
+    assert!(
+        seen.ui_images
+            .values()
+            .all(|image| image.width == 1254 && image.height == 1254)
+    );
+    connection.shutdown();
+    assert!(server.stop());
+}
